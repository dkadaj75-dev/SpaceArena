{
  "id": "gamemode.duel-1v1",
  "type": "gamemode",
  "version": 1,
  "name": "Duel",
  "teams": "1v1",
  "launch": "online",
  "hidden": false,
  "bots": {
    "defaultProfile": "bot.rookie",
