    "type": "fragLimit",
    "count": 5
  },
  "eliminationEndsMatch": true,
  "respawn": {
    "enabled": false,
    "delay": 4
  },
  "boundaryRule": {
    "type": "damageAndBounce",
    "damagePerSec": 8,
    "restitution": 0.82
  },
  "rewards": {
    "win": 100,
    "loss": 25,
    "perKill": 10
  }
