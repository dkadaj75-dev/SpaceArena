{
  "id": "gamemode.practice-bots",
  "type": "gamemode",
  "version": 1,
  "name": "Practice vs Bots",
  "teams": "2v2",
  "defaultArena": "arena.ring-nebula",
  "winCondition": {
    "type": "fragLimit",
    "count": 10
  },
  "eliminationEndsMatch": false,
  "respawn": {
    "enabled": true,
    "delay": 3
  },
  "boundaryRule": {
    "type": "damageAndBounce",
    "damagePerSec": 20,
    "restitution": 0.82
  },
  "rewards": {
    "win": 0,
    "loss": 0,
    "perKill": 0
  },
  "bots": {
    "defaultProfile": "bot.rookie",
    "defaultShip": "ship.interceptor",
    "backfillWaitMs": 15000,
    "roster": [
      {
        "profile": "bot.rookie",
        "ship": "ship.interceptor",
        "team": 0,
        "count": 1
      },
      {
        "profile": "bot.rookie",
        "ship": "ship.interceptor",
        "team": 1,
        "count": 2
      }
    ]
  },
  "timeLimitCapSec": 600
}
