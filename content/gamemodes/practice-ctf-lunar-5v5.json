{
  "id": "gamemode.practice-ctf-lunar-5v5",
  "type": "gamemode",
  "version": 1,
  "name": "Capture the Flag — Lunar Crater",
  "teams": "2v2",
  "defaultArena": "arena.lunar-crater",
  "winCondition": {
    "type": "captureLimit",
    "count": 3
  },
  "ctf": {
    "pickupRadius": 5,
    "dropReturnSec": 10,
    "trailLength": 100
  },
  "eliminationEndsMatch": false,
  "respawn": {
    "enabled": true,
    "delay": 4
  },
  "boundaryRule": {
    "type": "damageAndBounce",
    "damagePerSec": 20,
    "restitution": 0.82
  },
  "rewards": {
    "win": 0,
    "loss": 0,
    "perKill": 0
  },
  "bots": {
    "defaultProfile": "bot.flagrunner",
    "defaultShip": "ship.interceptor",
    "backfillWaitMs": 15000,
    "randomizeLoadouts": true,
    "roster": [
      {
        "profile": "bot.flagrunner",
        "team": 0,
        "count": 4
      },
      {
        "profile": "bot.flagrunner",
        "team": 1,
        "count": 5
      }
    ]
  },
  "timeLimitCapSec": 600
}
