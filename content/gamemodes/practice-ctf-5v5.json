{
  "id": "gamemode.practice-ctf-5v5",
  "type": "gamemode",
  "version": 1,
  "name": "CTF 5v5",
  "launch": "online",
  "teams": "5v5",
  "defaultArena": "arena.lunar-rift",
  "winCondition": {
    "type": "captureLimit",
    "count": 3
  },
  "ctf": {
    "pickupRadius": 7.5,
    "dropReturnSec": 10,
    "trailLength": 100
  },
  "eliminationEndsMatch": false,
  "respawn": {
    "enabled": true,
    "delay": 4
  },
  "boundaryRule": {
    "type": "damageAndBounce",
    "damagePerSec": 20,
    "restitution": 0.82
  },
  "rewards": {
    "win": 0,
    "loss": 0,
    "perKill": 0
  },
  "bots": {
    "defaultProfile": "bot.flagrunner",
    "defaultShip": "ship.interceptor",
    "backfillWaitMs": 10000,
    "randomizeLoadouts": true,
    "roster": [
      { "profile": "bot.flagrunner", "team": 0, "count": 2 },
      { "profile": "bot.aggressive", "team": 0, "count": 1 },
      { "profile": "bot.cautious", "team": 0, "count": 1 },
      { "profile": "bot.flagrunner", "team": 1, "count": 2 },
      { "profile": "bot.aggressive", "team": 1, "count": 1 },
      { "profile": "bot.cautious", "team": 1, "count": 1 },
      { "profile": "bot.rookie", "team": 1, "count": 1 }
    ]
  },
  "timeLimitCapSec": 600
}
