{
  "id": "theme.default",
  "type": "theme",
  "version": 1,
  "name": "Default Theme",
  "colors": {
    "--hud-bg": "#0a0e1a",
    "--hud-primary": "#57d8ff",
    "--hud-accent": "#ff8c42",
    "--hud-danger": "#ff4d5e",
    "--hud-text": "#e6f0ff"
  },
  "fonts": {
    "body": "system-ui, sans-serif",
    "display": "'Orbitron', system-ui, sans-serif"
  },
  "hud": {
    "scale": 1.0,
    "moduleButtonRadiusPx": 32,
    "safeAreaInsetPx": 12,
    "moduleButtonGapPx": 10,
    "minimapSizePx": 128,
    "minimapRangeUnits": 100,
    "gaugeWidthPx": 132,
    "notificationMaxVisible": 3,
    "thumbZoneFraction": 0.4,
    "moduleCluster": {
      "anchor": "bottom-right",
      "layout": "arc",
      "buttonRadiusPx": 32,
      "gapPx": 10,
      "arcRadiusPx": 144,
      "arcStartDeg": 180,
      "arcSweepDeg": -90,
      "maxPerRow": 2,
      "offsetXPx": 24,
      "offsetYPx": 34
    },
    "landscape": {
      "scale": 0.85,
      "safeAreaInsetPx": 10,
      "minimapSizePx": 104,
      "gaugeWidthPx": 120,
      "moduleCluster": {
        "buttonRadiusPx": 28,
        "gapPx": 8,
        "arcRadiusPx": 126,
        "offsetXPx": 22,
        "offsetYPx": 30
      }
    }
  },
  "haptics": {
    "enabled": true,
    "overheatPattern": [60, 50, 120],
    "killPattern": [25, 40, 25]
  },
  "audio": {
    "enabled": true,
    "defaultMasterVolume": 0.8,
    "defaultSfxVolume": 0.8,
    "maxVoices": 16,
    "retriggerGapMs": 45,
    "cues": {
      "playerDamaged": "[SOUND: hit_thud]",
      "shieldAbsorb": "[SOUND: shield_hit]",
      "playerKill": "[SOUND: kill_confirm]",
      "playerDeath": "[SOUND: explosion_heavy]",
      "overheat": "[SOUND: overheat_warning]",
      "boundaryWarning": "[SOUND: boundary_warn]"
    }
  },
  "menu": {
    "colors": {
      "base": "#04070f",
      "panel": "#0b1424",
      "primary": "#57d8ff",
      "accent": "#ff8c42",
      "text": "#e8f1ff",
      "muted": "#8ba3c4",
      "border": "#1d3a5e"
    },
    "backdrop": {
      "nebulaPrimary": "#0f4f7a",
      "nebulaAccent": "#7a3a12",
      "nebulaOpacity": 0.55,
      "starDensity": 0.5,
      "vignette": 0.55
    },
    "title": {
      "text": "SPACE ARENA",
      "subtitle": "TACTICAL SHIP COMBAT",
      "letterSpacingEm": 0.32,
      "glow": 0.5
    }
  },
  "juice": {
    "hitFlash": {
      "enabled": true,
      "durationMs": 160,
      "color": "#ffd9a0",
      "scale": 1.25,
      "intensity": 0.5,
      "maxConcurrent": 8
    },
    "shieldRipple": {
      "enabled": true,
      "color": "#57d8ff",
      "periodMs": 1400,
      "radiusScale": 1.5,
      "scaleWobble": 0.06,
      "minAlpha": 0.1,
      "maxAlpha": 0.26
    },
    "deploy": {
      "extendDistance": 0.18,
      "overshoot": 0.9,
      "spinDegrees": 45
    },
    "explosions": {
      "default": "fx.explosion-medium",
      "asteroid": "fx.explosion-rock",
      "byShipClass": {
        "light": "fx.explosion-light",
        "medium": "fx.explosion-medium",
        "heavy": "fx.explosion-heavy"
      },
      "burstCount": 60,
      "poolPerEffect": 3
    }
  }
}
