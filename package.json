{
  "name": "space-arena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "validate:content": "tsx tools/validate-content.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "tsx": "^4.19.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
